&Вместо("{{METHOD_NAME}}")
Процедура {{STUB_NAME}}({{SIGNATURE}})
	ПараметрыМетода = Мокито.МассивПараметров({{PARAMETERS_ARRAY}});
	ПрерватьВыполнение = Ложь;
	Результат = МокитоПерехват.АнализВызова(
		{{MODULE_NAME}}, "{{METHOD_NAME}}", ПараметрыМетода, ПрерватьВыполнение);
	Если НЕ ПрерватьВыполнение Тогда
		ПродолжитьВызов({{FORWARD_ARGS}});
	КонецЕсли;
КонецПроцедуры
